{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deep Server Analyzer",
  "mainBinaryName": "Deep Server Analyzer",
  "version": "1.2.0",
  "identifier": "com.demonad112.analyzer",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deep Server Analyzer",
        "width": 1200,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1430 ws://localhost:1430; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Demonad112",
    "homepage": "https://github.com/Demonad112/special-memory-analyzer",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "license": "Apache-2.0",
    "copyright": "Copyright (c) 2026 Demonad112",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
