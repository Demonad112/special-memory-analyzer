{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(corepack pnpm install)",
      "Bash(corepack pnpm test:*)",
      "Bash(corepack pnpm lint:*)",
      "Bash(corepack pnpm exec vitest:*)",
      "Bash(corepack pnpm exec tsc:*)",
      "Bash(corepack pnpm exec vue-tsc:*)",
      "Bash(corepack pnpm exec prettier:*)",
      "Bash(corepack pnpm exec eslint:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(pytest:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
