{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(corepack pnpm install)",
      "Bash(corepack pnpm test:*)",
      "Bash(corepack pnpm quality)",
      "Bash(corepack pnpm rust:test)",
      "Bash(corepack pnpm exec vitest:*)",
      "Bash(corepack pnpm exec tsc:*)",
      "Bash(corepack pnpm exec vue-tsc:*)",
      "Bash(corepack pnpm exec prettier:*)",
      "Bash(corepack pnpm exec eslint:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo metadata *)",
      "Bash(gh run watch *)",
      "Bash(corepack pnpm typecheck)",
      "Bash(corepack pnpm format:check)",
      "PowerShell(git fetch *)",
      "PowerShell(git grep *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run watch *)",
      "PowerShell(corepack pnpm test)",
      "PowerShell(corepack pnpm quality)",
      "PowerShell(corepack pnpm typecheck)",
      "PowerShell(corepack pnpm format:check)",
      "PowerShell(corepack pnpm rust:test)",
      "PowerShell(corepack pnpm rust:clippy)",
      "PowerShell(corepack pnpm rust:fmt:check)",
      "PowerShell(Get-Date *)",
      "PowerShell(Get-Command *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(Remove-Item * -Recurse -Force*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "claude-community": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-community.git"
      }
    }
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "gate-and-ship@claude-community": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-setup.sh\" || true",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
